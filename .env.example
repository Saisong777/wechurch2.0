# App
NODE_ENV=development
PORT=5001
# Optional staging safety. Do not copy production secrets into staging.
# APP_ENV=staging
# STAGING_ACCESS_CODE=independent-random-code-at-least-16-characters
# STAGING_EXPECTED_ENVIRONMENT_ID=railway-staging-environment-id
# STAGING_EXPECTED_DB_HOST=staging-postgres.railway.internal
# UPLOAD_ROOT=/data
# DISABLE_OUTBOUND_EMAIL=1
# DISABLE_MORNING_BRIEF=1

# Database
# Use a local/staging database for development. Do not point local work at production.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wechurch

# Auth / sessions
SESSION_SECRET=replace-with-a-long-random-string
PUBLIC_BASE_URL=http://localhost:5001

# AI integrations
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
# SoulGym AI reports: full reports default to gemini-2.5-flash; fast mode defaults to gemini-2.5-flash-lite.
SOULGYM_AI_MODEL=
SOULGYM_AI_FAST_MODEL=

# Google OAuth, optional unless login with Google is enabled locally
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google-only registration requires a valid OAuth configuration.
# AUTH_REGISTRATION_MODE=google-only
# B only: use a separate Google web client with this exact redirect URI.
# STAGING_GOOGLE_LOGIN_ENABLED=1
# STAGING_GOOGLE_CLIENT_ID=<same as the B GOOGLE_CLIENT_ID>
# GOOGLE_CALLBACK_URL=https://wechurch-staging-staging.up.railway.app/api/callback

# LINE Login / LIFF, optional unless LINE login is enabled locally
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
# B only: enable after verifying the separate B Login channel in LINE Console.
# STAGING_LINE_LOGIN_ENABLED=1
# STAGING_LINE_CHANNEL_ID=<B login channel ID>
# LINE_PROVIDER_ID=<church provider ID>
# LINE_PROVIDER_CHANNELS={"<A channel ID>":"<provider ID>","<B channel ID>":"<provider ID>"}
# LINE_CALLBACK_URL=https://<B hostname>/api/line-login/callback
LINE_CALLBACK_PATH=/api/line-login/callback
LINE_CALLBACK_URL=

# Email / webhooks, optional for local development
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# Legacy Replit compatibility, optional
REPLIT_DOMAINS=
